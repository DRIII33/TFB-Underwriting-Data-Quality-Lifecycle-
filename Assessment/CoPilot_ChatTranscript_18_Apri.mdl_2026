TECHNICAL IMPLEMENTATION: IF Status IN ('Canceled', 'NonRenewed', 'Declined') AND CancellationReasonCode IS NOT NULL AND CancellationReasonCode NOT IN (SELECT InternalCode FROM TDI_Reason_Mapping) THEN VIOLATION = TRUE

VALIDATION QUERY:

SELECT 'VR-002-003' as Rule_ID, p.PolicyNumber, p.Status, p.CancellationReasonCode, 'Unmapped Reason Code' as Violation_Type FROM driiiportfolio.raw_underwriting_data.pc_policyperiod p LEFT JOIN driiiportfolio.raw_underwriting_data.TDI_Reason_Mapping t ON p.CancellationReasonCode = t.InternalCode WHERE p.Status IN ('Canceled', 'NonRenewed', 'Declined') AND p.CancellationReasonCode IS NOT NULL AND t.TDICode IS NULL;

